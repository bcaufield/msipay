# MSI Pay environment variables
# Copy to .env.local for local dev. In Vercel, set these in Project Settings → Environment Variables.

# Public site URL (used by auth callbacks, email links, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Drizzle + Postgres / Neon) ---
# Use the POOLED Neon connection string (host contains "-pooler").
DATABASE_URL=postgres://user:password@host:5432/msipay

# --- Auth (Auth.js / NextAuth v5) ---
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Resend API key for magic-link emails (https://resend.com/api-keys).
# If omitted in development, the sign-in link is printed to the server console.
AUTH_RESEND_KEY=
# Verified sender. "onboarding@resend.dev" works without domain setup but only
# delivers to your own Resend account email; use a verified domain (e.g.
# noreply@msipay.app) so magic links reach any invited recipient.
AUTH_EMAIL_FROM=noreply@msipay.app

# --- File storage (Phase 1, not yet wired) ---
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
